---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { business, pakete, faq, showThemeSwitch } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: boolean;
}
const { title, description, noindex = false, schema = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const prices = pakete.map((p) => p.price);

const ld = schema
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'EntertainmentBusiness',
        name: business.name,
        url: Astro.site?.href,
        email: business.email,
        priceRange: `${Math.min(...prices)}–${Math.max(...prices)} €`,
        address: { '@type': 'PostalAddress', addressLocality: business.city, addressCountry: 'DE' },
        areaServed: business.areaServed.map((c) => ({ '@type': 'City', name: c })),
        sameAs: [business.instagram],
        makesOffer: pakete.map((p) => ({
          '@type': 'Offer',
          name: p.name,
          price: p.price,
          priceCurrency: 'EUR',
          description: `${p.minutes} Minuten, bis ${p.kids} Kinder. ${p.text}`,
        })),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      },
    ]
  : [];
---
<!doctype html>
<html lang="de" data-theme="a">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {showThemeSwitch && (
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search).get('theme');
        var s = null;
        try { s = localStorage.getItem('pp-theme'); } catch (e) {}
        var t = p === 'a' || p === 'b' ? p : s === 'a' || s === 'b' ? s : 'a';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  )}
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip sr-only" href="#main">Zum Inhalt springen</a>
  <slot />
  {showThemeSwitch && <ThemeSwitch />}
</body>
</html>

<style>
  .skip:focus {
    position: fixed; left: 16px; top: 16px; z-index: 50; width: auto; height: auto; clip: auto; margin: 0;
    padding: 12px 18px; background: var(--accent); color: var(--on-accent); border-radius: 12px; font-weight: 700;
  }
</style>
