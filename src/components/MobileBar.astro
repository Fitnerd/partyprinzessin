---
import { whatsappUrl } from '../data/site';
---
<nav class="bar" aria-label="Schnellaktionen">
  <a href="#anfrage" class="btn btn-primary">Termin prüfen</a>
  <a href={whatsappUrl()} class="btn btn-dark" rel="noopener">WhatsApp</a>
</nav>

<style>
  .bar { display: none; }
  @media (max-width: 767px) {
    .bar {
      display: flex; gap: 10px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: var(--bg); border-top: 2px solid var(--line);
    }
    .btn { flex: 1; padding-inline: 8px; box-shadow: none; }
  }
</style>
