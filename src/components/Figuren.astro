---
import T from './T.astro';
import { Image } from 'astro:assets';
import { figuren } from '../data/site';
import { getFoto } from '../lib/fotos';
---
<section id="figuren" class="band section">
  <div class="container">
    <h2 class="section-title"><T k="figurenTitle" /></h2>
    <p class="section-lead only-a">Klassische Märchen, neu erzählt – und eigene Heldinnen.</p>
    <ul class="grid">
      {figuren.map((f) => {
        const foto = getFoto(f.slug);
        return (
        <li class:list={{ 'has-photo': foto }}>
          <a class="fig" href="#anfrage" data-figur={f.slug} aria-label={`${f.name} anfragen`}>
            {foto ? (
              <span class="img">
                <Image src={foto} alt="" widths={[300, 600].filter((w) => w <= foto.width).concat(foto.width < 600 ? [foto.width] : [])} sizes="(max-width: 700px) 50vw, 260px" format="webp" quality={80} />
                <span class="only-b tag">{f.tag}</span>
              </span>
            ) : (
              <span class="img" role="img" aria-label={`Platzhalter: Foto ${f.name}`}>
                <span class="only-a">Foto {f.name}</span>
                <span class="only-b tag">{f.tag}</span>
              </span>
            )}
            <strong class="name">{f.name}</strong>
            <span class="line only-a">{f.line}</span>
            <span class="cta" aria-hidden="true">Anfragen →</span>
          </a>
        </li>
        );
      })}
    </ul>
    <p class="more">Weitere Figuren auf Anfrage.</p>
  </div>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px; }
  .fig {
    height: 100%; display: flex; flex-direction: column; gap: 10px;
    border-radius: 24px; padding: 16px; background: var(--bg); color: var(--ink); text-decoration: none;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .fig:hover { color: var(--ink); transform: translateY(-4px); box-shadow: 6px 6px 0 var(--band-accent); }
  .fig:focus-visible { outline-color: var(--band-accent); }
  .img { aspect-ratio: 1; border-radius: 18px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px; font-size: 13px; font-weight: 500; }
  li:nth-child(3n+1) .img { background: var(--fig-1); color: var(--fig-ink-1); }
  li:nth-child(3n+2) .img { background: var(--fig-2); color: var(--fig-ink-2); }
  li:nth-child(3n+3) .img { background: var(--fig-3); color: var(--fig-ink-3); }
  .img { position: relative; overflow: hidden; }
  .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .name { font-family: var(--font-display); font-size: 22px; font-weight: 700; }
  .line { font-size: 15px; flex: 1; }
  .cta { font-weight: 700; font-size: 15px; color: var(--link-hover); }
  .more { margin: 28px 0 0; color: var(--band-accent); }
  @media (prefers-reduced-motion: reduce) { .fig, .fig:hover { transition: none; transform: none; } }

  /* Theme B: ganze Kachel farbig, Name groß unten */
  :global([data-theme="b"]) .fig { padding: 0; background: none; position: relative; min-height: 260px; }
  :global([data-theme="b"]) .fig:hover { box-shadow: none; }
  :global([data-theme="b"]) .fig .img { position: absolute; inset: 0; aspect-ratio: auto; border-radius: 24px; align-items: flex-start; justify-content: flex-start; padding: 20px; }
  :global([data-theme="b"]) li:nth-child(5n+4) .img { background: var(--accent-2); color: #fff; }
  :global([data-theme="b"]) li:nth-child(5n+5) .img { background: var(--card-bg); color: #fff; }
  :global([data-theme="b"]) .name { position: absolute; left: 20px; right: 20px; bottom: 48px; font-size: 24px; line-height: 1.05; font-weight: 800; color: #141118; hyphens: auto; overflow-wrap: anywhere; }
  :global([data-theme="b"]) .cta { position: absolute; left: 20px; bottom: 18px; color: #141118; font-size: 14px; }
  :global([data-theme="b"]) li:nth-child(5n+4) :is(.name, .cta),
  :global([data-theme="b"]) li:nth-child(5n+5) :is(.name, .cta) { color: #fff; }
  :global([data-theme="b"]) li:nth-child(5n+5) .fig { outline: 1px solid #4A4453; outline-offset: -1px; border-radius: 24px; }
  /* B mit Foto: Verlauf unten, Schrift weiß, Tag als Pille */
  :global([data-theme="b"]) .has-photo .img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,17,24,.85), rgba(20,17,24,0) 55%); }
  :global([data-theme="b"]) .has-photo :is(.name, .cta) { color: #fff; z-index: 1; }
  :global([data-theme="b"]) .has-photo .tag { position: relative; z-index: 1; background: #141118; color: #fff; padding: 4px 10px; border-radius: 999px; }
  .tag { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
</style>
