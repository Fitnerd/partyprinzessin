---
/** Foto aus src/assets/fotos/<name>.jpg – oder Platzhalter, solange es fehlt. */
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { getFoto } from '../lib/fotos';

interface Props {
  name: string;
  alt: string;
  label: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  position?: string;
  eager?: boolean;
}
const { name, alt, label, class: cls = '', sizes = '(max-width: 700px) 100vw, 50vw', widths = [400, 800, 1200], position = 'center', eager = false } = Astro.props;
const src = getFoto(name);
---
{src ? (
  <div class:list={['foto', cls]}>
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width).concat(widths.some((w) => w > src.width) ? [src.width] : [])}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      style={`object-position: ${position}`}
    />
  </div>
) : (
  <Placeholder class={cls} label={label} />
)}

<style>
  .foto { position: relative; overflow: hidden; }
  .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
